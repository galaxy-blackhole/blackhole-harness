{
  "name": "@galaxy-blackhole/gbh-pwsh-sandbox",
  "version": "0.2.1-alpha.4",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "description": "Bản viết lại của Galaxy Blackhole cho row pwsh-sandbox của DSH (@deepseek-ai/dsh-pwsh-sandbox): executor PowerShell tiêu thụ ctx.sandbox, báo chế độ + mức cưỡng chế + sự thật bị từ chối.",
  "scripts": {
    "build": "bun run build.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-pwsh-local": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-sandbox": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-shell": "0.2.1-alpha.4"
  },
  "gbh": {
    "peers": [
      "@deepseek-ai/dsh-pwsh-local",
      "@deepseek-ai/dsh-sandbox",
      "@deepseek-ai/dsh-sandbox-policy",
      "@deepseek-ai/dsh-shell"
    ],
    "row": {
      "id": "pwsh-sandbox",
      "disabled": true,
      "tests": [
        "tests/host/pwsh-sandbox.test.ts"
      ],
      "insertDisabled": {
        "js": "process.platform !== 'win32'"
      }
    },
    "provenance": {
      "stock": "@deepseek-ai/dsh-pwsh-sandbox"
    }
  },
  "types": "src/index.ts"
}
