{
  "name": "@galaxy-blackhole/gbh-shell-env",
  "version": "0.2.1-alpha.4",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "description": "Bản viết lại của Galaxy Blackhole cho row shell-env của DSH (@deepseek-ai/dsh-shell-env): môi trường shell độc lập với tool — sổ ctx.shellEnv của các biến DSH_* tin cậy, dựng ảnh chụp bất biến cho từng lượt gọi shell của model.",
  "scripts": {
    "build": "bun run build.ts"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-home-paths": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-shell": "0.2.1-alpha.4",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2"
  },
  "license": "MIT",
  "gbh": {
    "peers": [
      "@deepseek-ai/dsh-home-paths",
      "@deepseek-ai/dsh-shell"
    ],
    "row": {
      "id": "shell-env",
      "tests": [
        "tests/host/shell-env.test.ts"
      ]
    },
    "provenance": {
      "stock": "@deepseek-ai/dsh-shell-env"
    }
  },
  "types": "lib/types/index.d.ts"
}
