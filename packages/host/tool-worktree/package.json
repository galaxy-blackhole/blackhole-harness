    "@deepseek-ai/dsh-experimental-worktree": "0.2.1-alpha.4"
  },
  "gbh": {
    "peers": [
      "@deepseek-ai/dsh-tools",
      "@deepseek-ai/dsh-experimental-worktree"
    ],
    "row": {
