{
  "name": "@galaxy-blackhole/gbh-timeout-policy",
  "version": "0.2.1-alpha.4",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "description": "Bản viết lại của Galaxy Blackhole cho row timeout-policy của DSH (@deepseek-ai/dsh-tool-call-timeout-policy): chính sách timeout cho lượt gọi tool — vũ trang hạn chót mà CHÍNH TOOL khai lên exec.signal lúc dispatch, rồi trả TOOL_TIMEOUT khi hạn chót của plugin này thắng.",
  "scripts": {
    "build": "bun run build.ts"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-timeout": "0.2.1-alpha.4"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-timeout": "0.2.1-alpha.4"
  },
  "license": "MIT",
  "gbh": {
    "peers": [
      "@deepseek-ai/dsh-timeout"
    ],
    "row": {
      "id": "timeout-policy",
      "tests": [
        "tests/host/timeout-policy.test.ts"
      ]
    }
  },
  "dependencies": {
    "@galaxy-blackhole/gbh-timeout": "workspace:*"
  },
  "types": "lib/types/index.d.ts"
}
