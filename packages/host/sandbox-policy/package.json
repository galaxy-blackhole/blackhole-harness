{
  "name": "@galaxy-blackhole/gbh-sandbox-policy",
  "version": "0.2.1-alpha.4",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "description": "Ban viet lai cua Galaxy Blackhole cho row sandbox-policy cua DSH: nha chinh sach sandbox (ctx.sandboxPolicy) — che do mac dinh cua deployment, goc workspace du phong, va luot giai chinh sach cho tung loi goi capability.",
  "scripts": {
    "build": "bun run build.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2"
  },
  "gbh": {
    "peers": [
      "@deepseek-ai/cordis",
      "@deepseek-ai/schemastery"
    ],
    "row": {
      "id": "sandbox-policy",
      "tests": [
        "tests/host/sandbox-policy.test.ts"
      ],
      "config": {
        "mode": {
          "js": "process.env.DSH_PERMISSION_MODE ?? 'workspace-write'"
        },
        "workspaceRoot": {
          "js": "process.cwd()"
        }
      }
    },
    "provenance": {
      "stock": "@deepseek-ai/dsh-sandbox-policy"
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json"
  },
  "types": "src/index.ts"
}
