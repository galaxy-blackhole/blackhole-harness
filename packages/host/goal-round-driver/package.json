    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-goal": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-subagent": "0.2.1-alpha.4",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2"
  },
  "license": "MIT",
  "gbh": {
