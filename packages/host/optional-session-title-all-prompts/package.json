{
  "name": "@galaxy-blackhole/gbh-optional-session-title-all-prompts",
  "version": "0.2.1-alpha.4",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "description": "Bản viết lại của Galaxy Blackhole cho row optional-session-title-all-prompts của DSH (@deepseek-ai/dsh-session-title-all-prompts-llm): tiêu đề phiên sinh từ TOÀN BỘ prompt người dùng.",
  "scripts": {
    "build": "bun run build.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2",
    "@deepseek-ai/dsh-session-title": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-session-title-llm": "0.2.1-alpha.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2",
    "@deepseek-ai/dsh-session-title": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-session-title-llm": "0.2.1-alpha.4"
  },
  "license": "MIT",
  "gbh": {
    "peers": [
      "@deepseek-ai/cordis",
      "@deepseek-ai/schemastery",
      "@deepseek-ai/dsh-session-title",
      "@deepseek-ai/dsh-session-title-llm"
    ],
    "row": {
      "id": "optional-session-title-all-prompts",
      "ownedByBundle": true,
      "config": {
        "targetWords": 5,
        "targetCjkCharacters": 10,
        "maxInputBytes": 4096,
        "maxOutputTokens": 64,
        "timeoutMs": 60000
      },
      "tests": [
        "tests/host/optional-session-title-all-prompts.test.ts"
      ]
    }
  },
  "types": "src/index.ts"
}
