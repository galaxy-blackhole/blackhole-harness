{
  "name": "@galaxy-blackhole/gbh-approval",
  "version": "0.2.1-alpha.4",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "description": "Bản viết lại của Galaxy Blackhole cho row approval của DSH (@deepseek-ai/dsh-user-approval): seam duyệt của người ctx.approval — quyết định một lần qua waterfall approval/request có phạm vi agent, cặp sự kiện kiểm toán approval/asked + approval/decided, và chính sách duyệt theo phiên (ask · never).",
  "scripts": {
    "build": "bun run build.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.4"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json"
  },
  "gbh": {
    "tests": [
      "tests/host/approval.test.ts"
    ],
    "peers": [
      "@deepseek-ai/cordis",
      "@deepseek-ai/schemastery",
      "@deepseek-ai/dsh-llm",
      "@deepseek-ai/dsh-scope",
      "@deepseek-ai/dsh-session"
    ],
    "row": {
      "id": "approval",
      "config": {
        "policy": {
          "js": "(process.env.DSH_PERMISSION_MODE ?? 'workspace-write') === 'danger-full-access' ? 'never' : 'ask'"
        }
      },
      "tests": [
        "tests/host/approval.test.ts"
      ]
    }
  },
  "types": "lib/types/index.d.ts"
}
