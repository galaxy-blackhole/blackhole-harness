{
  "name": "@galaxy-blackhole/gbh-subagent-spawn-in-process",
  "version": "0.2.1-alpha.4",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "description": "Bản viết lại của Galaxy Blackhole cho row subagent-spawn-in-process của DSH (@deepseek-ai/dsh-subagent-spawn-in-process): backend subagent SPAWN trong cùng tiến trình — đăng ký một SubagentProvider tên `spawn` trên seam `ctx.subagents`, mỗi con là một Agent MỚI với phiên riêng và KHÔNG mang ngữ cảnh của cha.",
  "scripts": {
    "build": "bun run build.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-alpha.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2"
  },
  "license": "MIT",
  "gbh": {
    "peers": [
      "@deepseek-ai/dsh-subagent"
    ],
    "row": {
      "id": "subagent-spawn-in-process",
      "config": {
        "providerName": "spawn"
      },
      "tests": [
        "tests/host/subagent-spawn-in-process.test.ts"
      ]
    },
    "provenance": {
      "stock": "@deepseek-ai/dsh-subagent-spawn-in-process"
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json"
  },
  "types": "src/index.ts"
}
