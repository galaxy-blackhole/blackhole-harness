{
  "name": "@galaxy-blackhole/gbh-host-workspace-changes",
  "version": "0.2.1-alpha.4",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "description": "Records per-turn workspace file changes (git snapshot plus full-file capture) and diffs each file for the workspace UI.",
  "scripts": {
    "build": "bun run build.ts"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": "./lib/types.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2",
    "diff": "^9.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-subprocess": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-fs": "0.2.1-alpha.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-subprocess": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-fs": "0.2.1-alpha.4",
    "diff": "^9.0.0"
  },
  "gbh": {
    "row": {
      "id": "workspace-changes",
      "insertAs": "workspace-changes-ours",
      "tests": [
        "tests/host/workspace-changes.test.ts"
      ]
    },
    "provenance": {
      "stock": "@deepseek-ai/dsh-workspace-changes"
    }
  },
  "types": "lib/types/index.d.ts"
}
