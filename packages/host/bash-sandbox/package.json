{
  "name": "@galaxy-blackhole/gbh-bash-sandbox",
  "version": "0.2.1-alpha.4",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "description": "Bản viết lại của Galaxy Blackhole cho row bash-sandbox của DSH (@deepseek-ai/dsh-bash-sandbox): executor bash tiêu thụ ctx.sandbox, báo chế độ + mức cưỡng chế + sự thật bị từ chối.",
  "scripts": {
    "build": "bun run build.ts"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-bash-local": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-sandbox": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-shell": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-alpha.4"
  },
  "gbh": {
    "peers": [
      "@deepseek-ai/dsh-bash-local",
      "@deepseek-ai/dsh-sandbox",
      "@deepseek-ai/dsh-sandbox-policy",
      "@deepseek-ai/dsh-shell"
    ],
    "row": {
      "id": "bash-sandbox",
      "config": {
        "timeoutMs": 60000
      },
      "tests": [
        "tests/host/bash-sandbox.test.ts"
      ]
    },
    "provenance": {
      "stock": "@deepseek-ai/dsh-bash-sandbox"
    }
  },
  "types": "lib/types/index.d.ts"
}
