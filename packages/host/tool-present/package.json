{
  "name": "@galaxy-blackhole/gbh-host-tool-present",
  "version": "0.2.1-alpha.4",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "description": "The present tool: lets the agent hand the user a file as a deliverable, registered through the tools service.",
  "scripts": {
    "build": "bun run build.ts"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-fs": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-credentials": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-timeout": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.4"
  },
  "gbh": {
    "nested": {
      "kind": "preset",
      "pluginId": "tool-present",
      "stockId": "@deepseek-ai/dsh-tool-present",
      "presets": [
        "preset-standard",
        "preset-ptc",
        "preset-cordis"
      ]
    },
    "tests": [
      "tests/host/tool-present.test.ts"
    ],
    "provenance": {
      "stock": "@deepseek-ai/dsh-tool-present"
    },
    "peers": []
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2"
  },
  "types": "lib/types/index.d.ts",
  "devDependencies": {}
}
