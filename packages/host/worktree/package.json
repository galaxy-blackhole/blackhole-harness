{
  "name": "@galaxy-blackhole/gbh-worktree",
  "version": "0.2.1-alpha.4",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "description": "Bản viết lại của Galaxy Blackhole cho row worktree của DSH (@deepseek-ai/dsh-experimental-worktree): seam ctx.worktrees tạo nhánh Git mới + checkout mới tại một revision cục bộ rồi đưa phiên vào đó, dưới hạn tiến trình và chính sách tệp của chính phiên gọi.",
  "scripts": {
    "build": "bun run build.ts"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./src/*": "./src/*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-timeout": "0.2.1-alpha.4",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-timeout": "0.2.1-alpha.4",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2"
  },
  "gbh": {
    "peers": [
      "@deepseek-ai/cordis",
      "@deepseek-ai/dsh-timeout",
      "@deepseek-ai/schemastery"
    ],
    "row": {
      "id": "worktree",
      "ownedByBundle": true,
      "tests": [
        "tests/host/worktree.test.ts"
      ]
    }
  },
  "types": "src/index.ts"
}
