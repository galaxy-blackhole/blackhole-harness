{
  "name": "@galaxy-blackhole/gbh-session-stats",
  "version": "0.2.1-alpha.4",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "description": "Bản viết lại của Galaxy Blackhole cho row session-stats của DSH (@deepseek-ai/dsh-session-stats): đơn vị chiếu sessionStats — đếm lượt/bước toàn log và bốn loại thời gian tường (mô hình, công cụ, token đầu, giải mã) phục vụ qua seam sessionProjections.",
  "scripts": {
    "build": "bun run build.ts"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.4"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "license": "MIT",
  "gbh": {
    "peers": [
      "@deepseek-ai/dsh-llm",
      "@deepseek-ai/dsh-session-projection"
    ],
    "tests": [
      "tests/host/session-stats.test.ts"
    ],
    "row": {
      "id": "session-stats",
      "tests": [
        "tests/host/session-stats.test.ts"
      ]
    },
    "provenance": {
      "stock": "@deepseek-ai/dsh-session-stats"
    }
  },
  "types": "lib/types/index.d.ts"
}
