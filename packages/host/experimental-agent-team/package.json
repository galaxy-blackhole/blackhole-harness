      "@deepseek-ai/dsh-subagent",
      "@deepseek-ai/dsh-brand",
      "@deepseek-ai/schemastery",
      "zod"
    ],
    "row": {
      "id": "agent-team",
      "tests": [
        "tests/host/experimental-agent-team.test.ts"
      ],
      "config": {
        "maxMembers": 8,
        "maxTasks": 256,
        "maxMessageBytes": 65536,
        "disposalTimeoutMs": 5000
      },
      "ownedByBundle": true
    },
    "provenance": {
      "stock": "@deepseek-ai/dsh-experimental-agent-team",
