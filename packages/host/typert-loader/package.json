{
  "name": "@galaxy-blackhole/gbh-typert-loader",
  "version": "0.2.1-alpha.4",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "description": "Bản viết lại của Galaxy Blackhole cho row typert-loader của DSH (@deepseek-ai/dsh-typert-loader): bộ nạp typert — tự đăng ký vật thể TYPERT của mọi package plugin đã mount, theo dõi mount/unmount của Loader, và gỡ đăng ký khi entry xuống.",
  "scripts": {
    "build": "bun run build.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json"
  },
  "gbh": {
    "tests": [
      "tests/host/typert-loader.test.ts"
    ],
    "peers": [
      "@deepseek-ai/cordis",
      "@deepseek-ai/schemastery"
    ],
    "row": {
      "id": "typert-loader",
      "tests": [
        "tests/host/typert-loader.test.ts"
      ]
    },
    "provenance": {
      "stock": "@deepseek-ai/dsh-typert-loader"
    }
  },
  "types": "lib/types/index.d.ts"
