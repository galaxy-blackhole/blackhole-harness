{
  "name": "@galaxy-blackhole/gbh-host-plugin-manager",
  "version": "0.2.1-alpha.4",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "description": "Plugin install/remove infrastructure used by the Market: install specs, registry, patch application and build approval.",
  "scripts": {
    "build": "bun run build.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./types": "./lib/types.js",
    "./registry": "./lib/registry.js",
    "./typert": "./lib/typert.host.js",
    "./remote": "./lib/typert.remote-client.js",
    "./operations": "./lib/operations.js",
    "./tools": "./lib/tools.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-app-boot": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-util-values": "0.2.1-alpha.4",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2",
    "execa": "^9.6.0",
    "yaml": "^2.8.1",
    "zod": "^4.4.3",
    "@galaxy-blackhole/gbh-host-bundle-labels": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/dsh-brand": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-hmr": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-host-plugin-inventory": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-sandbox": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-subprocess": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-user-approval": "0.2.1-alpha.4"
  },
  "gbh": {
    "nested": {
      "kind": "preset",
      "pluginId": "tool-plugin-manager",
      "stockId": "@deepseek-ai/dsh-plugin-manager/tools",
      "presets": [
        "preset-standard",
        "preset-ptc",
        "preset-cordis"
      ]
    },
    "row": {
      "id": "plugin-manager",
      "disabled": true,
      "insertDisabled": {
        "js": "!ctx.get('profileContext')"
      },
      "tests": [
        "tests/host/plugin-manager.test.ts"
      ]
    },
    "provenance": {
      "stock": "@deepseek-ai/dsh-plugin-manager"
    },
    "peers": []
  },
  "types": "src/index.ts",
  "devDependencies": {}
}
