{
  "name": "@galaxy-blackhole/gbh-session-log",
  "version": "0.2.1-alpha.4",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "description": "Incremental lossless session-log request extension for the official DeepSeek LLM API",
  "scripts": {
    "build": "bun run build.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-brand": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-util-values": "0.2.1-alpha.4",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2",
    "@deepseek-ai/dsh-deepseek-llm-api-extensions": "0.2.1-alpha.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-brand": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-util-values": "0.2.1-alpha.4",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2"
  },
  "license": "MIT",
  "gbh": {
    "peers": [
      "@deepseek-ai/cordis",
      "@deepseek-ai/dsh-brand",
      "@deepseek-ai/dsh-session",
      "@deepseek-ai/dsh-util-values",
      "@deepseek-ai/schemastery",
      "@deepseek-ai/dsh-deepseek-llm-api-extensions"
    ],
    "row": {
      "id": "session-log-gbh",
      "config": {
        "enabled": false,
        "maxBytes": 8388608
      },
      "tests": [
        "tests/host/session-log.test.ts"
      ]
    },
    "provenance": {
      "stock": "@deepseek-ai/dsh-session-log-deepseek",
      "version": "0.2.1-alpha.4",
      "sha": "09171c53502b4c4a78a458dea8f94884107bc252239c4d12193acd46951d2e72"
    }
  },
  "types": "src/index.ts"
}
