{
  "name": "@galaxy-blackhole/gbh-credentials-local",
  "version": "0.2.1-alpha.4",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "description": "Bản viết lại của Galaxy Blackhole cho row credentials của DSH (@deepseek-ai/dsh-credentials-local): provider thông tin xác thực cục bộ đọc/ghi một tài liệu YAML trong home của harness.",
  "scripts": {
    "build": "bun run build.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-alpha.4",
    "chokidar": "5.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-alpha.4"
  },
  "gbh": {
    "peers": [
      "@deepseek-ai/dsh-credentials",
      "@deepseek-ai/dsh-atomic-write",
      "chokidar",
      "yaml"
    ],
    "row": {
      "id": "credentials",
      "aliases": [],
      "tests": [
        "tests/host/credentials-local.test.ts"
      ],
      "config": {
        "path": "/Users/buitronghieu/.galaxy/credentials.yaml"
      }
    },
    "provenance": {
      "stock": "@deepseek-ai/dsh-credentials-local"
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json"
  },
  "types": "src/index.ts"
}
