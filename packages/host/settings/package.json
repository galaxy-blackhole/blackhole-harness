{
  "name": "@galaxy-blackhole/gbh-settings",
  "version": "0.2.1-alpha.4",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "description": "Bản viết lại của Galaxy Blackhole cho row settings của DSH (@deepseek-ai/dsh-settings): dịch vụ settings — chiếu schema Config của từng plugin trong profile thành biểu mẫu, giữ revision, và ghi các trường volatile qua tệp patch của profile.",
  "scripts": {
    "build": "bun run build.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/cosmokit": "1.8.6",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2",
    "yaml": "^2.9.1"
  },
  "gbh": {
    "peers": [
      "@deepseek-ai/cordis",
      "@deepseek-ai/cordis-plugin-loader",
      "@deepseek-ai/schemastery",
      "yaml"
    ],
    "row": {
      "id": "settings",
      "disabled": true,
      "insertAs": "settings-ours",
      "insertDisabled": {
        "js": "!ctx.get('profileContext')"
      },
      "moduleIds": [
        "@galaxy-blackhole/gbh-settings"
      ],
      "aliases": [
        "@deepseek-ai/dsh-settings"
      ],
      "hostAliases": [
        "@deepseek-ai/dsh-settings"
      ]
    },
    "provenance": {
      "stock": "@deepseek-ai/dsh-settings"
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json"
  },
  "types": "src/index.ts"
}
