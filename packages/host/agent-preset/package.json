{
  "name": "@galaxy-blackhole/gbh-agent-preset",
  "version": "0.2.1-alpha.4",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "description": "Bản viết lại của Galaxy Blackhole cho gói @deepseek-ai/dsh-agent-preset (bốn row preset-standard · preset-ptc · preset-minimal · preset-cordis dùng CHUNG một gói): MỘT lớp plugin khai một preset agent — id · tên · mô tả · thứ tự · danh sách plugin con — lên sổ `agentPresets` của kernel.",
  "scripts": {
    "build": "bun run build.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-alpha.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2"
  },
  "license": "MIT",
  "gbh": {
    "peers": [
      "@deepseek-ai/cordis-plugin-loader",
      "@deepseek-ai/dsh-agent-preset-registry"
    ],
    "nested": {
      "stockId": "@deepseek-ai/dsh-agent-preset",
      "hostAliases": [
        "@deepseek-ai/dsh-agent-preset"
      ],
      "presets": []
    },
    "provenance": {
      "stock": "@deepseek-ai/dsh-agent-preset"
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json"
  },
  "types": "src/index.ts"
}
