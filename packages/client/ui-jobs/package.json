{
  "name": "@galaxy-blackhole/gbh-client-ui-jobs",
  "version": "0.2.1-alpha.4",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "description": "Ban viet lai cua Galaxy Blackhole cho row ui-jobs cua DSH (@deepseek-ai/dsh-client-ui-jobs).",
  "scripts": {
    "build": "bun run build.ts"
  },
  "exports": {
    "./locale/*.json": "./locale/*.json",
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-job-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@galaxy-blackhole/gbh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "gbh": {
    "row": {
      "id": "ui-jobs",
      "moduleIds": [
        "@galaxy-blackhole/gbh-client-ui-jobs"
      ],
      "tests": [
        "tests/client/ui-jobs.test.ts"
      ],
      "aliases": [
        "@deepseek-ai/dsh-client-ui-jobs"
      ]
    },
    "provenance": {
      "stock": "@deepseek-ai/dsh-client-ui-jobs"
    }
  },
  "types": "lib/types/index.d.ts"
}
