    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2"
  },
  "scripts": {
    "build": "bun run build.ts"
  },
  "license": "MIT",
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "gbh": {
    "row": {
      "id": "resources",
      "tests": [
        "tests/client/resources.test.ts"
      ],
      "moduleIds": [
        "@galaxy-blackhole/gbh-client-resources"
      ],
      "aliases": [
        "@deepseek-ai/dsh-client-resources"
      ]
    },
    "provenance": {
      "stock": "@deepseek-ai/dsh-client-resources"
    }
  },
  "types": "lib/types/index.d.ts"
}
