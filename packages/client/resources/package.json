{
  "name": "@galaxy-blackhole/gbh-client-resources",
  "private": true,
  "version": "0.2.1-alpha.4",
  "description": "Ban viet lai cua Galaxy Blackhole cho @deepseek-ai/dsh-client-resources (M5, task-16): mo hinh resource phia browser (ctx.resources + hook useResource)",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    "./locale/*.json": "./locale/*.json",
    ".": {
      "types": "./lib/types/index.d.ts",
