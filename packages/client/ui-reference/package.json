{
  "name": "@galaxy-blackhole/gbh-client-ui-reference",
  "version": "0.2.1-alpha.4",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "description": "Ban viet lai cua Galaxy Blackhole cho row ui-reference cua DSH (@deepseek-ai/dsh-client-ui-reference): nguon @file/@session hop nhat + chip tep/thu muc inline.",
  "exports": {
    "./locale/*.json": "./locale/*.json",
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun run build.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "gbh": {
    "row": {
      "id": "ui-reference",
      "tests": [
        "tests/client/ui-reference.test.ts"
      ],
      "moduleIds": [
        "@galaxy-blackhole/gbh-client-ui-reference"
      ],
      "aliases": [
        "@deepseek-ai/dsh-client-ui-reference"
      ]
    },
    "provenance": {
      "stock": "@deepseek-ai/dsh-client-ui-reference"
    }
  },
  "types": "lib/types/index.d.ts"
}
