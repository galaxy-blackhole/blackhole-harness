{
  "name": "@galaxy-blackhole/gbh-client-ui-sidebar-files",
  "version": "0.2.1-alpha.4",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "description": "Bản viết lại của Galaxy Blackhole cho row ui-sidebar-files (gốc: @deepseek-ai/dsh-client-ui-sidebar-files).",
  "scripts": {
    "build": "bun run build.ts"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-shortcuts"
      ],
      "platform": "web"
    }
  },
  "gbh": {
    "row": {
      "id": "ui-sidebar-files",
      "moduleIds": [
        "@galaxy-blackhole/gbh-client-ui-sidebar-files"
      ],
      "aliases": [
        "@deepseek-ai/dsh-client-ui-sidebar-files"
      ],
      "tests": [
        "tests/client/ui-sidebar-files.test.ts"
      ]
    },
    "provenance": {
      "stock": "@deepseek-ai/dsh-client-ui-sidebar-files"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2"
  },
  "types": "lib/types/index.d.ts"
}
