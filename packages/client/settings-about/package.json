{
  "name": "@galaxy-blackhole/gbh-client-settings-about",
  "version": "0.2.1-alpha.4",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "description": "Menu Thong tin (About) cho popup Settings — package DOC LAP, khong thay row nao cua GBH; chung minh duong cai plugin ngoai (G1) o tang UI.",
  "scripts": {
    "build": "bun run build.ts"
  },
  "exports": {
    "./locale/*.json": "./locale/*.json",
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "gbh": {
    "peers": [
      "@deepseek-ai/cordis"
    ]
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2"
  },
  "dependencies": {},
  "devDependencies": {},
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md"
  ],
  "types": "src/index.ts"
}
