{
  "name": "@galaxy-blackhole/gbh-client-connection",
  "version": "0.2.1-alpha.4",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "description": "Ban viet lai cua Galaxy Blackhole cho row connection cua DSH (@deepseek-ai/dsh-client-connection): ken RPC co xac thuc + vong doi the he ket noi.",
  "scripts": {
    "build": "bun run build.ts"
  },
  "exports": {
    "./locale/*.json": "./locale/*.json",
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "gbh": {
    "row": {
      "moduleIds": [
        "@galaxy-blackhole/gbh-client-connection"
      ],
      "id": "connection",
      "aliases": [
        "@deepseek-ai/dsh-client-connection"
      ],
      "inject": [
        "webStartup"
      ],
      "config": {
        "trustedHosts": {
          "js": "ctx.webStartup.trustedHosts"
        }
      },
      "tests": [
        "tests/client/connection.test.ts"
      ]
    },
    "provenance": {
      "stock": "@deepseek-ai/dsh-client-connection"
    }
  },
  "types": "src/index.ts"
}
