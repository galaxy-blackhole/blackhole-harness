{
  "name": "@galaxy-blackhole/gbh-tauri",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Galaxy Blackhole Desktop (Tauri) — desktop doc lap, viet lai kernel/core/ui/plugin theo tu tuong DSH",
  "workspaces": [
    "apps/cli",
    "apps/desktop",
    "packages/*",
    "packages/*/*",
    "tools/*"
  ],
  "scripts": {
    "check:rows": "bun run tools/check/rows.ts",
    "lab:row": "bun run tools/lab/row.ts",
    "check:app": "bun run tools/check/app-health.ts",
    "new:row": "bun run tools/scaffold/new-row.ts",
    "dev": "bun run apps/desktop/scripts/dev.ts",
    "dev:web": "bun run apps/cli/src/main.ts host --port 5439",
    "host": "bun run apps/cli/src/main.ts host",
    "doctor": "bun run apps/cli/src/main.ts doctor",
    "gate": "bun run tools/lint/gate.ts",
    "lint:header": "bun run tools/lint/header.ts",
    "lint:length": "bun run tools/lint/file-length.ts",
    "lint:jsdoc": "bun run tools/lint/jsdoc.ts",
    "lint:deps": "bun run tools/lint/dep-guard.ts",
    "parity:dump": "bun run tools/parity/dump.ts",
    "parity:shot": "bun run tools/parity/shot.ts",
    "parity:report": "bun run tools/parity/report.ts",
    "parity:surface": "bun run tools/parity/surface.ts",
    "tauri": "bun run apps/desktop/scripts/dev.ts --tauri-only",
    "upstream": "bun run scripts/upstream.ts",
    "host:install": "cd apps/host && bun install",
    "setup": "bun install && bun run host:install",
    "smoke": "bun run apps/cli/src/main.ts host --port 5451 & sleep 3; cd apps/desktop/src-tauri && GBH_DESKTOP_PORT=5451 ./target/debug/gbh-desktop --smoke; kill %1",
    "m5:status": "bun run tools/check/m5-status.ts",
    "row:cost": "bun run tools/check/row-cost.ts",
    "pack:app": "bun run apps/desktop/scripts/embed.ts",
    "pack:app:node": "node apps/desktop/scripts/embed.ts",
    "postinstall": "bun run tools/lib/link-scope.ts",
    "publish:harness": "node tools/publish-harness.mjs",
    "pack:harness": "cd npm-package && node prepare.mjs && npm pack --pack-destination ../dist-harness"
  },
