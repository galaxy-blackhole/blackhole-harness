{
  "name": "@galaxy-blackhole/gbh-desktop",
  "private": true,
  "version": "0.2.1-alpha.4",
  "type": "module",
  "description": "Vo Tauri cua Galaxy Blackhole Desktop",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri build",
    "embed": "bun run scripts/embed.ts",
    "bundle": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri build && bun run scripts/embed.ts",
    "tauri": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri",
    "smoke": "$HOME/.cargo/bin/cargo run --manifest-path src-tauri/Cargo.toml -- --smoke"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
