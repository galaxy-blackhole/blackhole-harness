{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Galaxy Blackhole Windows",
  "mainBinaryName": "galaxy-blackhole",
  "version": "0.1.5",
  "identifier": "com.galaxyblackhole.desktop.windows",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Galaxy Blackhole",
        "width": 1280,
        "height": 860,
        "resizable": true,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "resources/host",
      "resources/runtime"
    ]
  }
}
