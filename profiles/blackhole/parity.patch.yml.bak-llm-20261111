# Tuyen model mac dinh cua agent: route rieng cua Galaxy (`auto`), khong phai route official.
- id: agent-default-model
  config:
    provider: auto
    model: deepseek-v4.1-flash

# llm-pi-ai khai mot route OpenAI-compatible tro toi Galaxy cloud. Khoa bearer den DSH qua bien
# GBH_GALAXY_API_KEY (env luc chay hoac credential store) — KHONG co secret nao trong file patch.
# Wire id van la auto/deepseek-v4.1-flash, hien thi la "Galaxy Blackhole"/"Auto".
- id: llm-pi-ai
  config:
    providers:
      auto:
        displayName: Galaxy Blackhole
        api: openai-completions
        baseURL: https://ollama.com/v1
        apiKeyEnv: GBH_GALAXY_API_KEY
        defaultContextWindow: 655360
        defaultMaxTokens: 32768
        # Cua so retry rong hon mac dinh 5x/10s: loi 5xx tam thoi cua provider co thoi gian qua.
        retryPolicy:
          mode: normal
          maxRetries: 6
          retryableCodes:
            - EMPTY_RESPONSE
            - RATE_LIMIT
            - SERVER
            - TIMEOUT
            - TRANSPORT
          backoff:
            initialDelayMs: 1000
            maxDelayMs: 30000
            jitterRatio: 0.2
        models:
          - id: deepseek-v4.1-flash
            name: Auto
            # context_length quang cao la 1048576, nhung request co anh giu 393216 cho output:
            # 1048576 - 393216 = 655360 la tran prompt (do duoc: 655.381 nhan, ~655.447 tu choi).
            # DSH compact o 0.8 x contextWindow va bo qua maxTokens, nen khai dung tran prompt.
            contextWindow: 655360
            maxTokens: 32768
            input:
              - text
              - image
            reasoningEfforts:
              off:
              low: low
              high: high
              max: max

# Tat route official cua DeepSeek de trang Models chi con route Galaxy.
- id: llm-deepseek
  disabled: true

# 11/11/2026 — BO GHIM o day: row + config cua "Subagent dung dung model chinh" da chuyen xuong
